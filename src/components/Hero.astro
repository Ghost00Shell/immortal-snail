---
import Art from "../components/Art.astro";
---

<section class="hero section" aria-labelledby="hero-heading">
  <div class="hero__inner wrap">
    <h1 id="hero-heading" class="hero__heading">
      <span class="hero__line hero__line--offer" data-hero-line>
        You are given <span class="hero__figure">$10,000,000<span class="hero__dot">.</span></span>
      </span>
      <span class="hero__line hero__line--offer" data-hero-line>
        You are <span class="hero__stress">immortal</span>.
      </span>
    </h1>

    <div class="hero__cta" data-hero-line>
      <a class="hero__deal" href="#the-condition" data-deal>Deal?</a>
    </div>

    <p class="hero__condition" data-condition tabindex="-1">
      ah, well<span class="hero__condition-em">&hellip; there is one condition.</span>
    </p>

    <p class="hero__cue" data-scroll-cue aria-hidden="true">
      <span class="hero__arrow">&darr;</span>
    </p>
  </div>

  <!-- The star, sitting quietly in the garden. Small. Smiling. Patient.
       When the deal is struck it detaches to become the cursor companion. -->
  <div class="hero__snail" data-hero-snail data-parallax data-depth="0.12">
    <Art name="snail" label="A small, cheerful cartoon snail." />
  </div>

  <div class="hero__flora hero__flora--a" data-parallax data-depth="0.3">
    <Art name="flora-15" />
  </div>
  <div class="hero__flora hero__flora--b" data-parallax data-depth="0.2">
    <Art name="flora-03" />
  </div>
  <div class="hero__flora hero__flora--c" data-parallax data-depth="0.42">
    <Art name="flora-05" />
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__heading {
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 1.2vw, 0.9rem);
    font-size: var(--step-4);
    color: var(--display-ink);
  }

  .hero__figure {
    color: var(--leaf);
    white-space: nowrap;
  }
  .hero__dot {
    color: var(--display-ink);
  }

  .hero__stress {
    color: var(--teal-deep);
    font-style: italic;
  }

  /* The offer's tempting button. Struck once, it wakes the snail. */
  .hero__cta {
    margin-top: clamp(1.8rem, 5vw, 3rem);
  }

  .hero__deal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    color: var(--ink);
    background: var(--coral);
    text-decoration: none;
    padding: 0.7em 1.6em;
    border-radius: 999px;
    box-shadow: 0 12px 26px rgba(213, 96, 70, 0.32);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      background-color 0.35s var(--ease-out);
  }
  .hero__deal:hover {
    transform: translateY(-3px);
    background: var(--gold);
    box-shadow: 0 16px 32px rgba(213, 96, 70, 0.28);
  }
  .hero__deal:focus-visible {
    outline: 3px solid var(--teal-deep);
    outline-offset: 3px;
  }

  /* The catch. Visible by default; JS slides it in after the deal is struck. */
  .hero__condition {
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
    max-width: 34rem;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink-soft);
    text-wrap: balance;
  }
  .hero__condition:focus {
    outline: none;
  }
  .hero__condition-em {
    color: var(--display-ink);
  }

  .hero__cue {
    margin-top: clamp(1.4rem, 4vw, 2.4rem);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .hero__arrow {
    display: inline-block;
    animation: nudge 2.4s var(--ease-out) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  .hero__snail {
    position: absolute;
    z-index: 1;
    right: clamp(-2rem, 3vw, 5rem);
    bottom: clamp(4rem, 12vh, 10rem);
    width: clamp(160px, 26vw, 360px);
    filter: drop-shadow(0 24px 30px rgba(40, 70, 80, 0.22));
  }

  .hero__flora {
    position: absolute;
    z-index: 0;
    opacity: 0.95;
  }
  .hero__flora--a {
    width: clamp(70px, 9vw, 130px);
    top: 14%;
    right: 22%;
  }
  .hero__flora--b {
    width: clamp(90px, 12vw, 170px);
    bottom: 8%;
    left: 6%;
  }
  .hero__flora--c {
    width: clamp(40px, 6vw, 80px);
    top: 22%;
    left: 12%;
  }

  @media (max-width: 720px) {
    .hero__snail {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: clamp(2.5rem, 8vw, 4rem);
      width: clamp(150px, 46vw, 240px);
    }
    .hero__flora--a {
      display: none;
    }
    .hero {
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__arrow {
      animation: none;
    }
  }
</style>
