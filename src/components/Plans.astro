---
import Art from "../components/Art.astro";

/** Each escape plan and the snail's quiet, patient rebuttal. The futility
 *  always turns on time — never on shaky physics. */
const plans = [
  {
    idea: "You build a decoy snail.",
    reply: "You cannot fool a snail.",
    flora: "flora-01",
    depth: 0.3,
  },
  {
    idea: "You pay another snail to seduce it.",
    reply: "Snails are not romantics.",
    flora: "flora-10",
    depth: 0.22,
  },
  {
    idea: "You seal it in a concrete tomb.",
    reply: "Concrete lasts a century, which is not an eternity.",
    flora: "flora-12",
    depth: 0.36,
  },
  {
    idea: "You bury it in Antarctica, inside a mason jar.",
    reply: "As if climate change would not eventually bring me back.",
    flora: "flora-15",
    depth: 0.28,
  },
  {
    idea: "You move constantly. You never sleep in the same place twice.",
    reply: "I have nothing else to do but learn your patterns.",
    flora: "flora-03",
    depth: 0.32,
  },
  {
    idea: "You live inside a bubble.",
    reply: "You would have to come out eventually. And I'll be there.",
    flora: "flora-14",
    depth: 0.24,
  },
  {
    idea: "You move into a salt mine.",
    reply: "You will run out of salt long before I run out of patience.",
    flora: "flora-16",
    depth: 0.34,
  },
  {
    idea: "You launch it into space.",
    reply: "Orbits decay. Everything comes back down.",
    flora: "flora-13",
    depth: 0.3,
  },
];
---

<section class="plans section" aria-labelledby="plans-heading">
  <div class="wrap">
    <h2 id="plans-heading" class="plans__q" data-reveal>What would you do?</h2>

    <ol class="plans__list" role="list">
      {
        plans.map((p, i) => (
          <li class="plan" data-side={i % 2}>
            <div
              class="plan__art"
              data-parallax
              data-depth={p.depth.toString()}
            >
              <Art name={p.flora} />
            </div>
            <div class="plan__body">
              <p class="plan__idea" data-reveal>
                {p.idea}
              </p>
              <p class="plan__reply" data-reveal>
                <span class="plan__mark" aria-hidden="true">
                  <Art name="snail" />
                </span>
                <span class="plan__reply-text">{p.reply}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .plans {
    overflow: clip;
  }

  .plans__q {
    font-size: var(--step-3);
    color: var(--display-ink);
    text-align: center;
    max-width: 16ch;
    margin-inline: auto;
    margin-bottom: clamp(3.5rem, 10vw, 7rem);
  }

  .plans__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 13vw, 11rem);
  }

  .plan {
    display: flex;
    align-items: center;
    gap: clamp(1.6rem, 5vw, 4rem);
    max-width: 54rem;
    margin-inline: auto;
    width: 100%;
  }
  .plan[data-side="1"] {
    flex-direction: row-reverse;
  }

  .plan__art {
    flex: 0 0 clamp(96px, 15vw, 200px);
    filter: drop-shadow(0 16px 22px rgba(40, 70, 80, 0.16));
  }

  .plan__body {
    flex: 1 1 auto;
    max-width: 34ch;
  }

  .plan__idea {
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  .plan__reply {
    margin-top: 1.1rem;
    display: flex;
    align-items: flex-start;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 0.9rem;
    border-bottom-left-radius: 0.2rem;
    padding: 0.85rem 1.1rem;
    box-shadow: 0 14px 34px -26px rgba(30, 45, 52, 0.5);
  }

  .plan__reply::after {
    content: "";
    position: absolute;
    left: 0.85rem;
    bottom: -0.42rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--surface);
    border-left: 1px solid var(--surface-line);
    border-bottom: 1px solid var(--surface-line);
    transform: rotate(-36deg);
    border-bottom-left-radius: 0.16rem;
  }

  .plan__mark {
    position: absolute;
    width: 34px;
    left: -1.45rem;
    bottom: -2rem;
    transform: scaleX(1);
  }

  .plan__reply-text {
    font-style: italic;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .plan,
    .plan[data-side="1"] {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.4rem;
    }
    .plan__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 36ch;
    }
    .plan__reply {
      align-items: center;
      justify-content: center;
      text-align: center;
      margin-top: 1.5rem;
    }
    .plan__mark {
      left: -1.1rem;
      bottom: -2rem;
    }
    .plan__art {
      flex-basis: auto;
      width: clamp(110px, 34vw, 150px);
    }
  }
</style>
