---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource-variable/nunito/wght.css";
import "../styles/global.css";
import Art from "../components/Art.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "The Immortal Snail",
  description = "You are given ten million dollars. You are immortal. There is one condition.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#eaf6f3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Progressive enhancement flags set before first paint: `js` marks that
         scripting is available; `deal-armed` opts the hero into its click-to-
         reveal intro, unless the visitor arrived deep-linked at the condition. -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add("js");
        if (location.hash !== "#the-condition") h.classList.add("deal-armed");
      })();
    </script>
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>

    <!-- The companion: a snail that roams the page freely once the deal is
         struck, wandering off one edge and back in from another. Purely
         atmospheric, so it is hidden from assistive tech and pointer events,
         and removed entirely under reduced motion. -->
    <div class="companion" data-companion aria-hidden="true">
      <div class="companion__float" data-companion-float>
        <Art name="snail" class="companion__snail" />
      </div>
    </div>
    <div class="death-overlay" data-death-overlay>
      <p class="death-overlay__text" data-death-text role="status" aria-live="assertive">
        <span>You touched the snail and perished.</span>
        <span>It will now spend your $10 million on unspeakable things in your name.</span>
      </p>
      <button class="death-overlay__retry" type="button" data-death-retry>
        would you like to try this again, you rube?
      </button>
    </div>

    <div class="shell">
      <slot />
    </div>

    <script>
      import "../scripts/experience.js";
    </script>

    <style>
      .companion {
        position: fixed;
        top: 0;
        left: 0;
        width: clamp(58px, 7vw, 96px);
        z-index: var(--z-companion);
        pointer-events: none;
        will-change: transform;
        opacity: 0;
        transform: translate3d(-200px, -200px, 0);
      }
      .companion__snail {
        transform: scaleX(-1); /* default facing; JS drives it while roaming */
      }
      /* No pointer, or a user who opts out of motion: no floating companion. */
      @media (hover: none), (pointer: coarse) {
        .companion {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .companion {
          display: none;
        }
      }

      .death-overlay {
        position: fixed;
        inset: 0;
        z-index: calc(var(--z-companion) + 20);
        display: grid;
        place-items: center;
        background: #000;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .death-overlay__text {
        margin: 0;
        font-family: "Bricolage Grotesque Variable", "Nunito Variable", sans-serif;
        font-size: clamp(1.25rem, 3.8vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--paper-ink);
        text-align: center;
        max-width: min(28ch, 90vw);
        line-height: 1.2;
        opacity: 0;
        transform: translateY(20px);
      }

      .death-overlay__text span {
        display: block;
      }

      .death-overlay__text span + span {
        margin-top: 0.45em;
      }

      .death-overlay__retry {
        margin-top: 1.1rem;
        border: 0;
        border-radius: 999px;
        padding: 0.55rem 0.9rem;
        font: inherit;
        font-size: clamp(0.85rem, 2.2vw, 1rem);
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #1d1413;
        background: #f0d7c9;
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.28);
        opacity: 0;
        transform: translateY(36px);
        pointer-events: none;
      }

      .death-overlay__retry:hover {
        background: #f6e1d6;
      }
    </style>
  </body>
</html>
